      {
        "selector": "JSXOpeningElement[name.name='BayProgrammeRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|running|booked|unassigned)$/]",
        "message": "<BayProgrammeRow> state must be one of 'done' | 'running' | 'booked' | 'unassigned'."
