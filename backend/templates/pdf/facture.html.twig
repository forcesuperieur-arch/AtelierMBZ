{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set doc_title = 'Facture' %}
{% set reference = 'N° <strong>' ~ facture.numeroFacture ~ '</strong>' %}

{% set clientNom = ((facture.snapClientPrenom ?? (facture.client ? facture.client.prenom : null)) ~ ' '
                 ~ (facture.snapClientNom ?? (facture.client ? facture.client.nom : null)))|trim %}
{% set clientTel = facture.snapClientTelephone ?? (facture.client ? facture.client.telephone : null) %}
{% set clientEmail = facture.snapClientEmail ?? (facture.client ? facture.client.email : null) %}
{% set clientAdresse = facture.snapClientAdresse ?? (facture.client ? facture.client.adresse : null) %}

{% set vMarque = facture.snapVehiculeMarque ?? (facture.vehicule ? facture.vehicule.marque : null) %}
{% set vModele = facture.snapVehiculeModele ?? (facture.vehicule ? facture.vehicule.modele : null) %}
{% set vPlaque = facture.snapVehiculePlaque ?? (facture.vehicule ? facture.vehicule.plaque : null) %}
{% set vehiculeLibelle = (vMarque ~ ' ' ~ vModele)|trim %}

{# Une remise nulle ne doit pas produire une ligne « Remise −0,00 € ».
   L'ancien test comparait la chaîne à '0.00', donc un 0 entier ou un null
   affichait quand même la ligne. #}
{% set remise = facture.remiseMontant|default(0) %}
{% set aRemise = remise is not empty and (remise + 0) > 0 %}

{% block body %}

{% set headerMeta = [] %}
{% if facture.dateCreation|default(false) %}
    {% set headerMeta = headerMeta|merge(['Émise le ' ~ facture.dateCreation|date('d/m/Y')]) %}
{% endif %}
{% if facture.dateEcheance|default(false) %}
    {% set headerMeta = headerMeta|merge(['Échéance le ' ~ facture.dateEcheance|date('d/m/Y')]) %}
{% endif %}
{% if facture.statut|default(false) %}
    {% set statutClass = facture.statut in ['payee', 'payée', 'soldee'] ? 'badge badge-ok' : 'badge' %}
    {% set headerMeta = headerMeta|merge(['<span class="' ~ statutClass ~ '">' ~ facture.statut|replace({'_': ' '})|upper ~ '</span>']) %}
{% endif %}

{{ ui.header(doc_title|upper, reference, atelier, logo_data_uri, headerMeta, custom_header_html|default(null)) }}

{{ ui.columns([
    ui.field('Facturé à',
        (clientNom ? '<strong>' ~ clientNom ~ '</strong>' : '')
        ~ (clientAdresse ? '<br>' ~ clientAdresse : '')
        ~ (clientTel ? '<br>' ~ clientTel : '')
        ~ (clientEmail ? '<br>' ~ clientEmail : '')),
    ui.field('Véhicule', vehiculeLibelle ? (
        '<strong>' ~ vehiculeLibelle ~ '</strong>'
        ~ (vPlaque ? '<br>Plaque ' ~ vPlaque : '')
    ) : null),
]) }}

<table class="lines">
    <thead>
        <tr>
            <th>Désignation</th>
            <th>Référence</th>
            <th class="right nowrap">Qté</th>
            <th class="right nowrap">P.U. HT</th>
            <th class="right nowrap">TVA</th>
            <th class="right nowrap">Total HT</th>
        </tr>
    </thead>
    <tbody>
    {% for ligne in facture.lignes|default([]) %}
        <tr>
            <td>{{ ligne.designation }}</td>
            <td>{{ ligne.reference|default('—') }}</td>
            <td class="right nowrap">{{ ligne.quantite|qty }}</td>
            <td class="right nowrap">{{ ligne.prixUnitaireHt|eur }}</td>
            <td class="right nowrap">{{ ligne.tauxTva|pct }}</td>
            <td class="right nowrap">{{ ligne.totalLigneHt|eur }}</td>
        </tr>
    {% else %}
        <tr><td colspan="6" class="muted">Aucune ligne de facturation.</td></tr>
    {% endfor %}
    </tbody>
</table>

{{ ui.totals([
    facture.totalMoHt|default(null) is not empty ? { label: "Total main d'œuvre HT", value: facture.totalMoHt|eur } : null,
    facture.totalPiecesHt|default(null) is not empty ? { label: 'Total pièces HT', value: facture.totalPiecesHt|eur } : null,
    { label: 'Total HT', value: '<strong>' ~ facture.totalHt|eur ~ '</strong>', variant: 'rule' },
    aRemise ? { label: 'Remise', value: '−' ~ remise|eur } : null,
    facture.tvaMo|default(null) is not empty ? { label: 'TVA MO (' ~ facture.tvaMoTaux|pct ~ ')', value: facture.tvaMo|eur } : null,
    facture.tvaPieces|default(null) is not empty ? { label: 'TVA pièces (' ~ facture.tvaPiecesTaux|pct ~ ')', value: facture.tvaPieces|eur } : null,
    facture.totalTva|default(null) is not empty ? { label: 'Total TVA', value: facture.totalTva|eur } : null,
    { label: 'Total TTC', value: facture.totalTtc|eur, variant: 'grand' },
]) }}

{% if facture.notes|default(false) %}
    <div class="section">
        <div class="section-title">Notes</div>
        <p>{{ facture.notes|nl2br }}</p>
    </div>
{% endif %}

<div class="legal">
    Conditions de règlement : paiement à réception de facture{% if facture.dateEcheance|default(false) %}, au plus tard le {{ facture.dateEcheance|date('d/m/Y') }}{% endif %}.
    En cas de retard de paiement, une pénalité égale à trois fois le taux d'intérêt légal est exigible de plein droit,
    ainsi qu'une indemnité forfaitaire pour frais de recouvrement de 40 € (art. L441-10 et D441-5 du code de commerce).
    Aucun escompte n'est accordé pour paiement anticipé.
    {% if atelier.siret|default(false) %}<br>{{ atelier.nom|default('Atelier') }} — SIRET {{ atelier.siret }}{% if atelier.tvaIntracom|default(false) %} — TVA intracommunautaire {{ atelier.tvaIntracom }}{% endif %}.{% endif %}
</div>

{% endblock %}
