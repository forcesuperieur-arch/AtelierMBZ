{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set doc_title = "Historique d'entretien" %}

{% block extra_css %}
    .intervention { border: 1px solid #e5e7eb; padding: 7px 9px; margin-bottom: 7px; }
    /* L'en-tête d'intervention utilisait `display:flex` : dompdf l'ignore et le
       kilométrage repassait à la ligne au lieu de s'aligner à droite. */
    .interv-head { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
    .interv-head td { padding: 0 0 3px; border-bottom: 1px solid #f3f4f6; vertical-align: bottom; }
    .interv-date { font-weight: bold; color: {{ accent }}; font-size: 11.5px; }
    .list-label { font-weight: bold; color: #6b7280; font-size: 8px; text-transform: uppercase; letter-spacing: 0.4px; margin: 5px 0 1px; }
    .alerte { color: #b91c1c; }
    ul.compact { margin: 1px 0 0; padding-left: 14px; }
    ul.compact li { margin: 0; }
{% endblock %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    vehicule.plaque|default(false) ? 'Véhicule <strong>' ~ vehicule.plaque ~ '</strong>' : null,
    atelier,
    logo_data_uri,
    [
        (historique.totalInterventions|default(0)) ~ ' intervention(s) enregistrée(s)',
        'Édité le ' ~ 'now'|date('d/m/Y à H:i'),
    ],
    custom_header_html|default(null)
) }}

<div class="section no-break">
    <div class="section-title">Véhicule</div>
    <table class="lines">
        <tbody>
            <tr>
                <td style="width:25%;"><strong>Marque et modèle</strong></td>
                <td style="width:25%;">
                    {{ ((vehicule.marque|default('')) ~ ' ' ~ (vehicule.modele|default('')))|trim|default('—') }}
                    {%- if vehicule.annee|default(false) %} ({{ vehicule.annee }}){% endif -%}
                </td>
                <td style="width:25%;"><strong>Immatriculation</strong></td>
                <td>{{ vehicule.plaque|default('—') }}</td>
            </tr>
            <tr>
                <td><strong>Cylindrée</strong></td>
                <td>{{ vehicule.cylindree|default(false) ? vehicule.cylindree ~ ' cm³' : '—' }}</td>
                <td><strong>Type</strong></td>
                <td>{{ vehicule.typeMoto|default('—') }}</td>
            </tr>
            {% if vehicule.client|default(false) %}
                <tr>
                    <td><strong>Propriétaire</strong></td>
                    <td colspan="3">{{ ((vehicule.client.prenom|default('')) ~ ' ' ~ (vehicule.client.nom|default('')))|trim|default('—') }}</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
</div>

<div class="section">
    <div class="section-title">Interventions</div>

    {% for intervention in historique.interventions|default([]) %}
        <div class="intervention no-break">
            <table class="interv-head">
                <tr>
                    <td>
                        <span class="interv-date">{{ intervention.date|default(false) ? intervention.date|date('d/m/Y') : '—' }}</span>
                        {% if intervention.typeIntervention|default(false) %}
                            <span class="badge" style="margin-left:6px;">{{ intervention.typeIntervention }}</span>
                        {% endif %}
                        {% if intervention.mecanicien|default(false) %}
                            <span class="small muted" style="margin-left:6px;">{{ intervention.mecanicien }}</span>
                        {% endif %}
                    </td>
                    <td class="right nowrap">
                        {% if intervention.kilometrage|default(false) %}<strong>{{ intervention.kilometrage|km }}</strong>{% endif %}
                    </td>
                </tr>
            </table>

            {% if intervention.ordres|default([])|length %}
                <div class="list-label">Ordres de réparation</div>
                <ul class="compact">
                    {% for ordre in intervention.ordres %}<li>OR n° {{ ordre.numero }}</li>{% endfor %}
                </ul>
            {% endif %}

            {% if intervention.travaux|default([])|length %}
                <div class="list-label">Travaux</div>
                <ul class="compact">
                    {% for travail in intervention.travaux %}{% if travail %}<li>{{ travail }}</li>{% endif %}{% endfor %}
                </ul>
            {% endif %}

            {% if intervention.pieces|default([])|length %}
                <div class="list-label">Pièces remplacées</div>
                <ul class="compact">
                    {% for piece in intervention.pieces %}
                        <li>{{ piece.designation }}{% if piece.reference|default(false) %} (réf. {{ piece.reference }}){% endif %} × {{ piece.quantite|qty }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if intervention.alertes|default([])|length %}
                <div class="list-label alerte">Alertes</div>
                <ul class="compact">
                    {% for alerte in intervention.alertes %}<li class="alerte">{{ alerte }}</li>{% endfor %}
                </ul>
            {% endif %}
        </div>
    {% else %}
        <div class="box"><p class="muted" style="margin:0;">Aucune intervention enregistrée pour ce véhicule.</p></div>
    {% endfor %}
</div>

<div class="legal">
    Document généré automatiquement par {{ atelier.nom|default('Atelier Moto') }}
    {%- if historique.generatedAt|default(false) %} — certification {{ historique.generatedAt }}{% endif %}.
    Il retrace les interventions enregistrées dans l'atelier et ne préjuge pas des opérations réalisées ailleurs.
</div>

{% endblock %}
