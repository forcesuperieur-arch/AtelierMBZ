# Edge STAFF (back-office) — appli atelier, derrière login applicatif.
# EXPOSÉ SUR INTERNET (APP_DOMAIN = ex. atelier.motoblouz.com) : durci pour ne rien
# fuiter. `localhost` conservé pour les contrôles locaux exécutés sur le serveur.
http://{$APP_DOMAIN:localhost}, https://{$APP_DOMAIN:localhost}, http://localhost, https://localhost {
	encode zstd gzip

	# Mercure : le hub accepte des abonnements ANONYMES → fuite PII s'il est public.
	# Non exposé ici. À distance, le front staff bascule sur le polling.
	# (Correctif propre à prévoir : abonnements Mercure authentifiés par JWT.)
	handle /.well-known/mercure {
		respond "Not found" 404
	}

	# Doc API (API Platform) : divulgation d'infos → masquée en public.
	handle /api/docs* {
		respond "Not found" 404
	}

	# API staff (authentification applicative requise).
	handle /api/* {
		reverse_proxy php:8000
	}

	# Uploads : logos atelier uniquement (non sensibles). Les photos et signatures
	# brutes (PII) ne sont JAMAIS servies en statique — endpoints contrôlés only.
	handle /uploads/logos/* {
		reverse_proxy php:8000
	}
	handle /uploads/* {
		respond "Not found" 404
	}

	# Appli staff (Nuxt) — login requis.
	handle {
		reverse_proxy nuxt:3000
	}
}

# Public-facing edge (client-only).
# Exposes only customer-facing pages: booking, suivi, demande, mentions, politique.
# Blocks back-office (admin, planning, vo, etc.) and internal companion pages
# (companion / vo-companion are used on-premise from the workshop tablet).
# Dev : port 81 local (défaut posé dans docker-compose). Prod : poser
# PUBLIC_DOMAIN dans .env → Caddy sert le domaine en HTTPS (Let's Encrypt
# automatique, ports 80/443 requis).
{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Public API — whitelist stricte : booking/suivi/demande/restitution publics,
	# portail client, clauses légales. Tout le reste (companion, photos staff,
	# debug, APIs internes) reste inaccessible depuis Internet.
	@public_api {
		path /api/public/* /api/client /api/client/* /api/clauses-legales /api/clauses-legales/*
	}
	handle @public_api {
		reverse_proxy php:8000
	}

	# Uploads : logos atelier uniquement. Les photos RDV passent par les
	# endpoints contrôlés (/api/public/photos tokenisé, /api/client/photos
	# authentifié) — jamais par le chemin de fichier brut.
	@public_uploads {
		path /uploads/logos/*
	}
	handle @public_uploads {
		reverse_proxy php:8000
	}

	# Mercure n'est pas exposé au public : aucune page publique ne s'y abonne
	# et le hub accepte les abonnements anonymes (fuite PII sinon).

	# Whitelisted public pages.
	@public_pages {
		path /public/booking* /public/suivi /public/suivi/* /public/demande /public/demande/* /public/mentions-legales* /public/politique-confidentialite* /restitution /restitution/*
	}
	handle @public_pages {
		reverse_proxy nuxt:3000
	}

	# Ancienne URL de la vitrine publique (servie par le front staff) : la page
	# vit désormais côté portail client, sous /client (app.baseURL de client-nuxt).
	handle /landing {
		redir * /client/landing 301
	}
	handle /landing/* {
		redir * /client/landing 301
	}

	# Client portal (espace client + vitrine publique) — served by client-nuxt on port 3001.
	handle /client {
		redir * /client/ 308
	}
	handle /client/* {
		reverse_proxy client-nuxt:3001
	}

	# Nuxt assets, branding, favicon — required by any page rendered above.
	@nuxt_assets {
		path /_nuxt/* /__nuxt/* /favicon.ico /branding/* /robots.txt /manifest.json /sw.js
	}
	handle @nuxt_assets {
		reverse_proxy nuxt:3000
	}

	# Root → redirect to public landing page (portail client).
	handle / {
		redir * /client/landing 302
	}

	# Everything else (admin, planning, vo, companion, login, profile, ...) is hidden.
	handle {
		respond "Not found" 404
	}
}
