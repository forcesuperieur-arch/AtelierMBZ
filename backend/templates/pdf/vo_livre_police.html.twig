{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{#
  Registre légal : onze colonnes. En A4 portrait elles se chevauchaient et le
  texte se coupait — le document est rendu en paysage (voir PdfService).
#}
{% set accent = '#1e3a5f' %}
{% set accent_soft = '#eef2f7' %}
{% set doc_title = 'Livre de police' %}

{% block extra_css %}
    @page { margin: 12mm 10mm 16mm 10mm; }
    table.register { width: 100%; border-collapse: collapse; font-size: 7.5px; }
    table.register th {
        background: {{ accent }}; color: #ffffff; padding: 4px 4px;
        text-align: left; font-size: 7px; text-transform: uppercase; letter-spacing: 0.3px;
    }
    table.register td { padding: 3px 4px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
    /* Zébrage posé sur les cellules : dompdf ne peint pas un fond de <tr>. */
    table.register tr.alt td { background: #f7f8fa; }
{% endblock %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    'Extrait du registre — ' ~ (entries|default([]))|length ~ ' écriture(s)',
    atelier,
    logo_data_uri,
    ['Édité le ' ~ 'now'|date('d/m/Y à H:i')],
    custom_header_html|default(null)
) }}

<table class="register">
    <thead>
        <tr>
            <th>N° ordre</th>
            <th>Type</th>
            <th>Date acq.</th>
            <th>Désignation du bien</th>
            <th>Immat.</th>
            <th>Vendeur</th>
            <th>Pièce d'identité</th>
            <th class="right">Prix achat</th>
            <th>Date vente</th>
            <th>Acheteur</th>
            <th class="right">Prix vente</th>
        </tr>
    </thead>
    <tbody>
        {% for e in entries|default([]) %}
            <tr class="{{ loop.index0 is odd ? 'alt' : '' }}">
                <td class="nowrap">{{ e.numeroOrdre|default('—') }}</td>
                <td>{{ e.type|default('—')|capitalize }}</td>
                <td class="nowrap">{{ e.dateAcquisition|default(false) ? e.dateAcquisition|date('d/m/Y') : '—' }}</td>
                <td>{{ e.descriptionBien|default('—') }}</td>
                <td class="nowrap">{{ e.immatriculation|default('—') }}</td>
                <td>{{ ((e.vendeurPrenom|default('')) ~ ' ' ~ (e.vendeurNom|default('')))|trim|default('—') }}</td>
                <td>{{ ((e.vendeurIdType|default('')) ~ ' ' ~ (e.vendeurIdNumber|default('')))|trim|default('—') }}</td>
                <td class="right nowrap">{{ e.prixAchat|eur }}</td>
                <td class="nowrap">{{ e.dateVente|default(false) ? e.dateVente|date('d/m/Y') : '—' }}</td>
                <td>{{ ((e.acheteurPrenom|default('')) ~ ' ' ~ (e.acheteurNom|default('')))|trim|default('—') }}</td>
                <td class="right nowrap">{{ e.prixVente|eur }}</td>
            </tr>
        {% else %}
            <tr><td colspan="11" class="muted">Aucune écriture sur la période.</td></tr>
        {% endfor %}
    </tbody>
</table>

<div class="legal">
    Registre tenu conformément aux articles 321-7 et 321-8 du code pénal et au décret n° 2009-1104.
    Les écritures sont portées sans blanc ni rature ; le registre est conservé pendant cinq ans et tenu
    à la disposition des services de police et de gendarmerie.
    {% if atelier.siret|default(false) %}<br>{{ atelier.nom|default('Atelier Moto') }} — SIRET {{ atelier.siret }}.{% endif %}
</div>

{% endblock %}
