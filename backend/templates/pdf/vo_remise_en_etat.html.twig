{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set accent = '#1e3a5f' %}
{% set accent_soft = '#eef2f7' %}
{% set doc_title = 'Document de remise en état VO' %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    campaign.label|default(null) ?: document.reference|default(null),
    atelier,
    logo_data_uri,
    [
        'Campagne n° ' ~ campaign.index|default('—') ~ ' — ' ~ record.typeLabel|default('VO'),
        document.generatedAt|default(false) ? 'Édité le ' ~ document.generatedAt|date('d/m/Y à H:i') : null,
    ],
    custom_header_html|default(null)
) }}

{% if document.signed|default(false) %}
    <div class="box-ok">
        Version signée archivée
        {%- if document.signature.signedAt|default(false) %} le {{ document.signature.signedAt|date('d/m/Y à H:i') }}{% endif -%}.
    </div>
{% else %}
    <div class="box-warn">
        Document de consultation interne — cette version n'est pas signée.
    </div>
{% endif %}

<div class="section no-break">
    <div class="section-title">Contexte de la campagne</div>
    {{ ui.columns([
        ui.field('Titre', campaign.title|default(null)),
        ui.field('Statut et priorité',
            (campaign.status|default('—')) ~ ' / ' ~ (campaign.priority|default('—'))),
    ]) }}
    {{ ui.columns([
        ui.field('Demandée le', campaign.requestedAt|default(false) ? campaign.requestedAt|date('d/m/Y à H:i') : null),
        ui.field('Validée le', campaign.validatedAt|default(false) ? campaign.validatedAt|date('d/m/Y à H:i') : null),
        ui.field('Dossier source', record.reference|default(null)),
        ui.field('Contrepartie',
            ((record.counterparty.prenom|default('')) ~ ' ' ~ (record.counterparty.nom|default('')))|trim),
    ]) }}
</div>

<div class="section no-break">
    <div class="section-title">Véhicule</div>
    <table class="lines">
        <tbody>
            <tr>
                <td style="width:25%;"><strong>Marque et modèle</strong></td>
                <td style="width:25%;">{{ ((vehicle.marque|default('')) ~ ' ' ~ (vehicle.modele|default('')))|trim|default('—') }}</td>
                <td style="width:25%;"><strong>Plaque</strong></td>
                <td>{{ vehicle.plaque|default('—') }}</td>
            </tr>
            <tr>
                <td><strong>Numéro VIN</strong></td>
                <td>{{ vehicle.vin|default('—') }}</td>
                <td><strong>Kilométrage</strong></td>
                <td>{{ vehicle.mileage|default(false) ? vehicle.mileage|km : '—' }}</td>
            </tr>
            <tr>
                <td><strong>Cylindrée</strong></td>
                <td>{{ vehicle.cylindree|default(false) ? vehicle.cylindree ~ ' cm³' : '—' }}</td>
                <td><strong>Catégorie tarifaire</strong></td>
                <td>{{ vehicle.categorieNom|default('—') }}</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Synthèse des coûts</div>
    <table class="lines">
        <thead>
            <tr>
                <th class="right">MO estimée</th>
                <th class="right">Pièces estimées</th>
                <th class="right">Total estimé</th>
                <th class="right">Total réel</th>
                <th class="right">Pièces en attente</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="right nowrap">{{ summary.estimatedMoCost|eur }}</td>
                <td class="right nowrap">{{ summary.estimatedPartsCost|eur }}</td>
                <td class="right nowrap">{{ summary.estimatedTotalCost|eur }}</td>
                <td class="right nowrap">{{ summary.actualTotalCost|eur }}</td>
                <td class="right nowrap">{{ summary.pendingPiecesCount|default(0) }}</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Notes</div>
    <div class="box">
        <p><strong>Diagnostic VO</strong><br>{{ notes.diagnostic|default(false) ? notes.diagnostic|nl2br : '<span class="muted">Aucune note.</span>'|raw }}</p>
        <p><strong>Atelier</strong><br>{{ notes.workshop|default(false) ? notes.workshop|nl2br : '<span class="muted">Aucune note.</span>'|raw }}</p>
        <p style="margin-bottom:0;"><strong>Arbitrage business</strong><br>{{ notes.business|default(false) ? notes.business|nl2br : '<span class="muted">Aucune note.</span>'|raw }}</p>
    </div>
</div>

<div class="section no-break">
    <div class="section-title">Prestations atelier</div>
    <table class="lines">
        <thead>
            <tr>
                <th>Libellé</th>
                <th class="right nowrap">Qté</th>
                <th>Statut</th>
                <th class="right nowrap">Temps estimé</th>
                <th class="right nowrap">Coût estimé HT</th>
                <th class="right nowrap">Coût réel HT</th>
            </tr>
        </thead>
        <tbody>
        {% for line in lines|default([]) %}
            <tr>
                <td>{{ line.libelle }}{% if line.prestationCode|default(false) %}<br><span class="sub">{{ line.prestationCode }}</span>{% endif %}</td>
                <td class="right nowrap">{{ line.quantity|qty }}</td>
                <td>{{ line.status|default('—')|capitalize }}</td>
                <td class="right nowrap">{{ line.estimatedMinutes|default(false) ? line.estimatedMinutes|duree : '—' }}</td>
                <td class="right nowrap">{{ line.estimatedTotalHt|eur }}</td>
                <td class="right nowrap">{{ line.actualTotalHt|eur }}</td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="muted">Aucune prestation ajoutée.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Pièces</div>
    <table class="lines">
        <thead>
            <tr>
                <th>Libellé</th>
                <th>Référence</th>
                <th class="right nowrap">Qté</th>
                <th>Statut</th>
                <th class="right nowrap">Coût estimé HT</th>
                <th class="right nowrap">Coût réel HT</th>
            </tr>
        </thead>
        <tbody>
        {% for piece in pieces|default([]) %}
            <tr>
                <td>{{ piece.libelle }}</td>
                <td>{{ piece.reference|default('—') }}</td>
                <td class="right nowrap">{{ piece.quantity|qty }}</td>
                <td>{{ piece.status|default('—')|capitalize }}</td>
                <td class="right nowrap">{{ piece.estimatedTotalCostHt|eur }}</td>
                <td class="right nowrap">{{ piece.actualTotalCostHt|eur }}</td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="muted">Aucune pièce suivie.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% if document.signed|default(false) %}
    <div class="section no-break">
        <div class="section-title">Signature</div>
        {{ ui.signatures([
            {
                label: 'Signé par ' ~ ((document.signature.signedBy.prenom|default('')) ~ ' ' ~ (document.signature.signedBy.nom|default('')))|trim,
                image: document.signatureData|default(null),
                caption: (document.signature.signedAt|default(false) ? 'Le ' ~ document.signature.signedAt|date('d/m/Y à H:i') : '')
                    ~ (document.signature.ip|default(false) ? ' — IP ' ~ document.signature.ip : ''),
                fallback: 'Signature électronique enregistrée',
            },
        ]) }}
    </div>
{% endif %}

<div class="legal">
    Empreinte documentaire : {{ document.hash|default('—') }}
    {%- if document.generatedAt|default(false) %} — généré le {{ document.generatedAt|date('d/m/Y à H:i') }}{% endif %}.
</div>

{% endblock %}
