{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{# Le devis garde son ambre distinctif : à l'atelier, la couleur suffit à
   distinguer un devis d'une facture dans une pile de documents. #}
{% set accent = '#b45309' %}
{% set accent_soft = '#fffbeb' %}

{% set doc_title = 'Devis' %}
{% set reference = 'N° <strong>' ~ devis.numeroDevis ~ '</strong>' %}

{% set clientNom = ((devis.snapClientPrenom ?? (devis.client ? devis.client.prenom : null)) ~ ' '
                 ~ (devis.snapClientNom ?? (devis.client ? devis.client.nom : null)))|trim %}
{% set clientTel = devis.snapClientTelephone ?? (devis.client ? devis.client.telephone : null) %}
{% set clientEmail = devis.snapClientEmail ?? (devis.client ? devis.client.email : null) %}

{% set vMarque = devis.snapVehiculeMarque ?? (devis.vehicule ? devis.vehicule.marque : null) %}
{% set vModele = devis.snapVehiculeModele ?? (devis.vehicule ? devis.vehicule.modele : null) %}
{% set vPlaque = devis.snapVehiculePlaque ?? (devis.vehicule ? devis.vehicule.plaque : null) %}
{% set vehiculeLibelle = (vMarque ~ ' ' ~ vModele)|trim %}

{% set remise = devis.remiseMontant|default(0) %}
{% set aRemise = remise is not empty and (remise + 0) > 0 %}
{% set acompte = devis.acompteDemande|default(0) %}
{% set aAcompte = acompte is not empty and (acompte + 0) > 0 %}

{% block body %}

{% set headerMeta = [] %}
{% if devis.dateCreation|default(false) %}
    {% set headerMeta = headerMeta|merge(['Établi le ' ~ devis.dateCreation|date('d/m/Y')]) %}
{% endif %}
{% if devis.statut|default(false) %}
    {% set headerMeta = headerMeta|merge(['<span class="badge badge-warn">' ~ devis.statut|replace({'_': ' '})|upper ~ '</span>']) %}
{% endif %}

{{ ui.header(doc_title|upper, reference, atelier, logo_data_uri, headerMeta, custom_header_html|default(null)) }}

{{ ui.columns([
    ui.field('Client',
        (clientNom ? '<strong>' ~ clientNom ~ '</strong>' : '')
        ~ (clientTel ? '<br>' ~ clientTel : '')
        ~ (clientEmail ? '<br>' ~ clientEmail : '')),
    ui.field('Véhicule', vehiculeLibelle ? (
        '<strong>' ~ vehiculeLibelle ~ '</strong>'
        ~ (vPlaque ? '<br>Plaque ' ~ vPlaque : '')
        ~ (devis.kilometrage|default(false) ? '<br>' ~ devis.kilometrage|km : '')
    ) : null),
]) }}

<table class="lines">
    <thead>
        <tr>
            <th>Désignation</th>
            <th>Type</th>
            <th class="right nowrap">Qté</th>
            <th class="right nowrap">P.U. HT</th>
            <th class="right nowrap">TVA</th>
            <th class="right nowrap">Total TTC</th>
        </tr>
    </thead>
    <tbody>
    {% for ligne in devis.lignes|default([]) %}
        <tr>
            <td>
                {{ ligne.designation }}
                {%- if ligne.descriptionDetail|default(false) %}<br><span class="sub">{{ ligne.descriptionDetail }}</span>{% endif -%}
            </td>
            <td>{{ ligne.typeLigne|default('—') }}</td>
            <td class="right nowrap">{{ ligne.quantite|qty }}</td>
            <td class="right nowrap">{{ ligne.prixUnitaireHt|eur }}</td>
            <td class="right nowrap">{{ ligne.tauxTva|pct }}</td>
            <td class="right nowrap">{{ ligne.totalLigneTtc|eur }}</td>
        </tr>
    {% else %}
        <tr><td colspan="6" class="muted">Aucune ligne au devis.</td></tr>
    {% endfor %}
    </tbody>
</table>

{{ ui.totals([
    devis.totalMoHt|default(null) is not empty ? { label: "Total main d'œuvre HT", value: devis.totalMoHt|eur } : null,
    devis.totalPiecesHt|default(null) is not empty ? { label: 'Total pièces HT', value: devis.totalPiecesHt|eur } : null,
    { label: 'Total HT', value: '<strong>' ~ devis.totalHt|eur ~ '</strong>', variant: 'rule' },
    aRemise ? { label: 'Remise' ~ (devis.remisePourcentage|default(0) + 0 > 0 ? ' (' ~ devis.remisePourcentage|pct ~ ')' : ''), value: '−' ~ remise|eur } : null,
    devis.totalTva|default(null) is not empty ? { label: 'TVA', value: devis.totalTva|eur } : null,
    { label: 'Total TTC', value: devis.totalTtc|eur, variant: 'grand' },
    aAcompte ? { label: 'Acompte demandé', value: acompte|eur, variant: 'rule' } : null,
]) }}

<div class="section no-break">
    <div class="box-accent">
        <strong>Validité du devis :</strong>
        {%- if devis.dateValidite|default(false) %} jusqu'au {{ devis.dateValidite|date('d/m/Y') }}
        {%- elseif devis.validiteJours|default(false) %} {{ devis.validiteJours }} jours à compter de la date d'établissement
        {%- else %} nous consulter
        {%- endif -%}.
        Passé ce délai, les prix et disponibilités des pièces sont susceptibles d'être révisés.
    </div>
</div>

{% if devis.notesClient|default(false) %}
    <div class="section">
        <div class="section-title">Notes</div>
        <p>{{ devis.notesClient|nl2br }}</p>
    </div>
{% endif %}

<div class="section no-break">
    <div class="section-title">Acceptation du devis</div>
    {# Libellés tenus sur une seule ligne : dès que l'un passe à deux lignes,
       sa case descend et les deux encadrés ne sont plus alignés. #}
    {{ ui.columns([
        '<span class="field-label">Date</span><div class="signature-box"></div>',
        '<span class="field-label">Signature — mention « Bon pour accord »</span><div class="signature-box"></div>',
    ]) }}
</div>

<div class="legal">
    Devis gratuit et sans engagement. Les travaux ne seront engagés qu'après retour du présent devis signé
    {%- if aAcompte %} et versement de l'acompte de {{ acompte|eur }}{% endif %}.
    Toute prestation supplémentaire découverte en cours d'intervention fera l'objet d'un accord préalable du client.
    {% if atelier.siret|default(false) %}<br>{{ atelier.nom|default('Atelier') }} — SIRET {{ atelier.siret }}{% if atelier.tvaIntracom|default(false) %} — TVA intracommunautaire {{ atelier.tvaIntracom }}{% endif %}.{% endif %}
</div>

{% endblock %}
