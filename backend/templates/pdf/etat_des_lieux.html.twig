{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{#
  État des lieux d'entrée. Document archivé UNE SEULE FOIS à la signature et
  jamais régénéré : tout ce qui manque ici manque définitivement.
#}

{% set doc_title = "État des lieux d'entrée" %}

{% set vMarque = edl.snapVehiculeMarque ?? (rdv.vehicule ? rdv.vehicule.marque : null) %}
{% set vModele = edl.snapVehiculeModele ?? (rdv.vehicule ? rdv.vehicule.modele : null) %}
{% set vPlaque = edl.snapVehiculePlaque ?? (rdv.vehicule ? rdv.vehicule.plaque : null) %}
{% set clientNom = ((edl.snapClientPrenom ?? (rdv.client ? rdv.client.prenom : null)) ~ ' '
                 ~ (edl.snapClientNom ?? (rdv.client ? rdv.client.nom : null)))|trim %}
{% set vehiculeLibelle = (vMarque ~ ' ' ~ vModele)|trim %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    rdv.id|default(false) ? 'RDV n° <strong>' ~ rdv.id ~ '</strong>' : null,
    atelier,
    logo_data_uri,
    [
        rdv.dateRdv|default(false)
            ? 'Rendez-vous du ' ~ rdv.dateRdv|date('d/m/Y') ~ (rdv.heureRdv|default(false) ? ' à ' ~ rdv.heureRdv|date('H:i') : '')
            : null,
        edl.createdAt|default(false) ? 'Établi le ' ~ edl.createdAt|date('d/m/Y à H:i') : null,
    ],
    custom_header_html|default(null)
) }}

{{ ui.columns([
    ui.field('Client', clientNom ? '<strong>' ~ clientNom ~ '</strong>' : null),
    ui.field('Véhicule', vehiculeLibelle ? (
        '<strong>' ~ vehiculeLibelle ~ '</strong>' ~ (vPlaque ? '<br>Plaque ' ~ vPlaque : '')
    ) : null),
]) }}

<div class="section no-break">
    <div class="section-title">Constat à l'entrée du véhicule</div>
    <table class="lines">
        <tbody>
            <tr>
                <td style="width:50%;"><strong>Kilométrage constaté</strong></td>
                <td><strong>Niveau de carburant</strong></td>
            </tr>
            <tr>
                <td style="font-size:14px;font-weight:bold;color:{{ accent }};">
                    {{ edl.kilometrage is not null ? edl.kilometrage|km : 'Non renseigné' }}
                </td>
                <td style="font-size:14px;font-weight:bold;color:{{ accent }};">
                    {{ niveau_carburant_label|default('Non renseigné') }}
                </td>
            </tr>
        </tbody>
    </table>
</div>

{% if edl.observations|default(false) %}
    <div class="section no-break">
        <div class="section-title">Observations</div>
        <div class="box-accent"><p>{{ edl.observations|nl2br }}</p></div>
    </div>
{% endif %}

{% if photos_entree|default([])|length %}
    <div class="section no-break">
        <div class="section-title">Photos d'entrée du véhicule</div>
        {{ ui.photos(photos_entree, "Photo d'entrée") }}
    </div>
{% endif %}

<div class="section no-break">
    {{ ui.signatures([
        {
            label: 'Signature du client',
            image: edl.signatureClient|default(null),
            caption: edl.signedAt|default(false) ? 'Signé le ' ~ edl.signedAt|date('d/m/Y à H:i') : null,
        },
        {
            label: "Établi par l'atelier",
            image: null,
            fallback: edl.signedByNom|default('Non renseigné'),
        },
    ]) }}
    <p class="tiny">Le client reconnaît l'exactitude de l'état des lieux d'entrée de son véhicule décrit ci-dessus.</p>
</div>

{% if edl.signedHash|default(false) %}
    <div class="legal">
        Empreinte d'intégrité : {{ edl.signedHash }}
        {%- if edl.signedAt|default(false) %}<br>Horodatage de signature : {{ edl.signedAt|date('d/m/Y H:i:s') }}{% endif %}
    </div>
{% endif %}

{% endblock %}
