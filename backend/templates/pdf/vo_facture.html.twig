{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set accent = '#2D5573' %}
{% set accent_soft = '#E5F1F7' %}

{% set doc_title = "Facture véhicule d'occasion" %}
{% set reference = 'N° <strong>' ~ facture.numeroFacture ~ '</strong>' %}

{% set acheteur = ((facture.snapClientPrenom|default('')) ~ ' ' ~ (facture.snapClientNom|default('')))|trim %}
{% set vehiculeLibelle = ((facture.snapVehiculeMarque|default('')) ~ ' ' ~ (facture.snapVehiculeModele|default('')))|trim %}
{# `??` refuse une expression filtrée à gauche : elvis sur la valeur utile. #}
{% set immat = facture.immatriculation|default(null) ?: facture.snapVehiculePlaque|default(null) %}

{% block body %}

{% set headerMeta = [] %}
{% if facture.dateCreation|default(false) %}
    {% set headerMeta = headerMeta|merge(['Émise le ' ~ facture.dateCreation|date('d/m/Y')]) %}
{% endif %}
{% set headerMeta = headerMeta|merge([
    facture.dateEcheance|default(false)
        ? 'Échéance le ' ~ facture.dateEcheance|date('d/m/Y')
        : 'Règlement comptant'
]) %}
{% if facture.regimeTva|default(false) %}
    {% set headerMeta = headerMeta|merge(['<span class="badge">Régime TVA : ' ~ facture.regimeTva|upper ~ '</span>']) %}
{% endif %}

{{ ui.header(doc_title|upper, reference, atelier, logo_data_uri, headerMeta, custom_header_html|default(null)) }}

{{ ui.columns([
    ui.field('Acheteur',
        (acheteur ? '<strong>' ~ acheteur ~ '</strong>' : '')
        ~ (facture.snapClientAdresse|default(false) ? '<br>' ~ facture.snapClientAdresse : '')
        ~ (facture.snapClientTelephone|default(false) ? '<br>' ~ facture.snapClientTelephone : '')
        ~ (facture.snapClientEmail|default(false) ? '<br>' ~ facture.snapClientEmail : '')),
    ui.field('Vendeur',
        '<strong>' ~ atelier.nom|default('Atelier Moto') ~ '</strong>'
        ~ (atelier.adresse|default(false) ? '<br>' ~ atelier.adresse : '')
        ~ (atelier.cp|default(false) or atelier.ville|default(false) ? '<br>' ~ atelier.cp ~ ' ' ~ atelier.ville : '')
        ~ (atelier.siret|default(false) ? '<br>SIRET ' ~ atelier.siret : '')),
]) }}

<div class="section no-break">
    <div class="section-title">Véhicule vendu</div>
    <table class="lines">
        <tbody>
            <tr><td style="width:32%;"><strong>Marque et modèle</strong></td><td>{{ vehiculeLibelle|default('—') }}</td></tr>
            <tr><td><strong>Immatriculation</strong></td><td>{{ immat|default('—') }}</td></tr>
            {% if facture.vinFacture|default(false) %}
                <tr><td><strong>Numéro VIN</strong></td><td>{{ facture.vinFacture }}</td></tr>
            {% endif %}
            {% if facture.kilometrage|default(false) %}
                <tr><td><strong>Kilométrage compteur</strong></td><td>{{ facture.kilometrage|km }}</td></tr>
            {% endif %}
            {% if facture.datePremiereMiseEnCirculationFacture|default(false) %}
                <tr><td><strong>Première mise en circulation</strong></td><td>{{ facture.datePremiereMiseEnCirculationFacture|date('d/m/Y') }}</td></tr>
            {% endif %}
        </tbody>
    </table>
</div>

{{ ui.totals([
    facture.mentionTvaMarge|default(false) and facture.prixAchatHt|default(null) is not empty
        ? { label: "Prix d'achat du véhicule", value: facture.prixAchatHt|eur } : null,
    { label: 'Total HT', value: facture.totalHt|eur },
    { label: facture.mentionTvaMarge|default(false) ? 'TVA sur la marge' : 'TVA', value: facture.totalTva|eur, variant: 'rule' },
    { label: 'Total TTC', value: facture.totalTtc|eur, variant: 'grand' },
]) }}

<div class="legal">
    {% if facture.mentionTvaMarge|default(false) %}
        <p><strong>TVA sur la marge</strong> — article 297 A du CGI. La TVA est calculée sur la marge bénéficiaire ;
        elle n'est pas récupérable par l'acquéreur et ne figure pas distinctement sur la présente facture.</p>
    {% endif %}
    {% if facture.mentionGarantieConformite|default(false) %}
        <p><strong>Garanties légales</strong> — l'acheteur bénéficie de la garantie légale de conformité
        (art. L.217-3 et suivants du code de la consommation, deux ans) et de la garantie légale des vices cachés
        (art. 1641 et suivants du code civil), indépendamment de toute garantie commerciale.</p>
    {% endif %}
    {% if facture.notes|default(false) %}
        <p>{{ facture.notes|nl2br }}</p>
    {% endif %}
    <p>
        {{ atelier.nom|default('Atelier Moto') }}
        {%- if atelier.siret|default(false) %} — SIRET {{ atelier.siret }}{% endif %}
        {%- if atelier.tvaIntracom|default(false) %} — TVA intracommunautaire {{ atelier.tvaIntracom }}{% endif %}.
    </p>
</div>

{% endblock %}
