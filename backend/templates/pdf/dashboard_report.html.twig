{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set doc_title = 'Rapport analytique' %}

{% block extra_css %}
    .kpi { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
    .kpi td { width: 25%; border: 1px solid #e5e7eb; background: #fafafa; padding: 7px 9px; vertical-align: top; }
    .kpi .kpi-value { font-size: 15px; font-weight: bold; color: {{ accent }}; }
{% endblock %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    period.from|default(false) and period.to|default(false)
        ? 'Période du <strong>' ~ period.from ~ '</strong> au <strong>' ~ period.to ~ '</strong>'
        : null,
    atelier,
    logo_data_uri,
    ['Édité le ' ~ 'now'|date('d/m/Y à H:i')],
    custom_header_html|default(null)
) }}

<div class="section no-break">
    <div class="section-title">Indicateurs clés</div>
    <table class="kpi">
        <tr>
            <td><span class="field-label">Rendez-vous</span><span class="kpi-value">{{ kpi.nb_rdvs|default(0)|num(0) }}</span></td>
            <td><span class="field-label">Chiffre d'affaires HT</span><span class="kpi-value">{{ kpi.ca_ht|default(0)|eur }}</span></td>
            <td><span class="field-label">CA main d'œuvre HT</span><span class="kpi-value">{{ kpi.ca_mo_ht|default(0)|eur }}</span></td>
            <td><span class="field-label">CA pièces HT</span><span class="kpi-value">{{ kpi.ca_pieces_ht|default(0)|eur }}</span></td>
        </tr>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Tendance journalière</div>
    <table class="lines">
        <thead>
            <tr><th>Date</th><th class="right nowrap">CA HT</th></tr>
        </thead>
        <tbody>
        {% for row in trend|default([]) %}
            <tr>
                <td>{{ row.snapshot_date }}</td>
                <td class="right nowrap">{{ row.ca_du_jour_ht|default(0)|eur }}</td>
            </tr>
        {% else %}
            <tr><td colspan="2" class="muted">Aucune donnée sur la période.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Prestations les plus vendues</div>
    <table class="lines">
        <thead>
            <tr><th>Type d'intervention</th><th class="right nowrap">Volume</th><th class="right nowrap">CA généré</th></tr>
        </thead>
        <tbody>
        {% for service in topServices|default([]) %}
            <tr>
                <td>{{ service.type_intervention|default('—') }}</td>
                <td class="right nowrap">{{ service.count|default(0)|num(0) }}</td>
                <td class="right nowrap">{{ service.revenue|default(0)|eur }}</td>
            </tr>
        {% else %}
            <tr><td colspan="3" class="muted">Aucune donnée sur la période.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Activité par mécanicien</div>
    <table class="lines">
        <thead>
            <tr><th>Mécanicien</th><th class="right nowrap">Rendez-vous</th><th class="right nowrap">CA généré</th></tr>
        </thead>
        <tbody>
        {% for meca in mecas|default([]) %}
            <tr>
                <td>{{ meca.mecanicien_nom|default('—') }}</td>
                <td class="right nowrap">{{ meca.nb_rdvs|default(0)|num(0) }}</td>
                <td class="right nowrap">{{ meca.ca_genere|default(0)|eur }}</td>
            </tr>
        {% else %}
            <tr><td colspan="3" class="muted">Aucune donnée sur la période.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<div class="legal">
    Rapport interne {{ atelier.nom|default('Atelier Moto') }} — document non contractuel.
</div>

{% endblock %}
