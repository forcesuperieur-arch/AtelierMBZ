{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set accent = '#2D5573' %}
{% set accent_soft = '#E5F1F7' %}
{% set doc_title = 'Contrat de dépôt-vente' %}

{% set deposant = depot.deposant|default(null) %}
{% set vehicule = depot.vehicule|default(null) %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    'N° <strong>CDV-' ~ depot.id|default('—') ~ '</strong>',
    atelier,
    logo_data_uri,
    [depot.dateDebut|default(false) ? 'Conclu le ' ~ depot.dateDebut|date('d/m/Y') : null],
    custom_header_html|default(null)
) }}

{{ ui.columns([
    ui.field('Déposant',
        '<strong>' ~ ((deposant.prenom|default('')) ~ ' ' ~ (deposant.nom|default('')))|trim ~ '</strong>'
        ~ (deposant.adresse|default(false) ? '<br>' ~ deposant.adresse : '')
        ~ (deposant.telephone|default(false) ? '<br>' ~ deposant.telephone : '')
        ~ (deposant.email|default(false) ? '<br>' ~ deposant.email : '')
        ~ '<br><br><span class="field-label">Pièce d\'identité</span>'
        ~ (depot.deposantIdType|default('—'))
        ~ (depot.deposantIdNumber|default(false) ? ' n° ' ~ depot.deposantIdNumber : '')
        ~ (depot.deposantIdDate|default(false) ? ' du ' ~ depot.deposantIdDate|date('d/m/Y') : '')),
    ui.field('Dépositaire',
        '<strong>' ~ atelier.nom|default('Atelier Moto') ~ '</strong>'
        ~ (atelier.adresse|default(false) ? '<br>' ~ atelier.adresse : '')
        ~ (atelier.cp|default(false) or atelier.ville|default(false) ? '<br>' ~ atelier.cp ~ ' ' ~ atelier.ville : '')
        ~ (atelier.siret|default(false) ? '<br>SIRET ' ~ atelier.siret : '')),
]) }}

<div class="section no-break">
    <div class="section-title">Véhicule confié</div>
    <table class="lines">
        <tbody>
            <tr>
                <td style="width:25%;"><strong>Marque et modèle</strong></td>
                <td style="width:25%;">{{ ((vehicule.marque|default('')) ~ ' ' ~ (vehicule.modele|default('')))|trim|default('—') }}</td>
                <td style="width:25%;"><strong>Immatriculation</strong></td>
                <td>{{ vehicule.plaque|default('—') }}</td>
            </tr>
            <tr>
                <td><strong>Numéro VIN</strong></td>
                <td>{{ vehicule.vin|default('—') }}</td>
                <td><strong>Cylindrée</strong></td>
                <td>{{ vehicule.cylindree|default(false) ? vehicule.cylindree ~ ' cm³' : '—' }}</td>
            </tr>
            <tr>
                <td><strong>Année</strong></td>
                <td>{{ vehicule.annee|default('—') }}</td>
                <td><strong>Kilométrage</strong></td>
                <td>{{ vehicule.mileage|default(false) ? vehicule.mileage|km : '—' }}</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Conditions du mandat</div>
    <table class="lines">
        <tbody>
            <tr>
                <td style="width:34%;"><strong>Prix de vente souhaité</strong></td>
                <td>{{ depot.prixVenteSouhaite|eur }} TTC</td>
            </tr>
            {% if depot.prixMinimum|default(null) is not empty %}
                <tr><td><strong>Prix plancher accepté</strong></td><td>{{ depot.prixMinimum|eur }} TTC</td></tr>
            {% endif %}
            <tr>
                <td><strong>Commission du dépositaire</strong></td>
                <td>
                    {%- if depot.commissionType|default('') == 'forfait' -%}
                        {{ depot.commissionValeur|eur }} (forfait)
                    {%- else -%}
                        {{ depot.commissionValeur|pct }} du prix de vente effectif
                    {%- endif -%}
                </td>
            </tr>
            <tr>
                <td><strong>Durée du mandat</strong></td>
                <td>
                    {{ depot.dureeMandat|default('—') }} jours
                    {%- if depot.dateDebut|default(false) %} à compter du {{ depot.dateDebut|date('d/m/Y') }}{% endif -%}
                    {%- if depot.dateFin|default(false) %}, échéance le {{ depot.dateFin|date('d/m/Y') }}{% endif -%}
                </td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Clauses</div>
    <ol style="margin:0 0 6px;padding-left:16px;">
        <li>Le dépositaire s'engage à exposer le véhicule en vue de sa vente et à en assurer la garde avec diligence.</li>
        <li>Le déposant demeure propriétaire du véhicule jusqu'à la réalisation effective de la vente.</li>
        <li>Le dépositaire ne peut consentir une vente à un prix inférieur au prix convenu sans accord préalable et écrit du déposant.</li>
        <li>En cas de vente, le dépositaire reverse au déposant le prix de vente diminué de la commission convenue, dans un délai de quinze jours.</li>
        <li>Le déposant peut retirer le véhicule à tout moment, sous réserve d'un préavis de quarante-huit heures.</li>
    </ol>
    {% if depot.conditionsRestitution|default(false) %}
        <p><strong>Conditions de restitution :</strong> {{ depot.conditionsRestitution }}</p>
    {% endif %}
    {% if depot.assuranceInfo|default(false) %}
        <p><strong>Assurance :</strong> {{ depot.assuranceInfo }}</p>
    {% endif %}
    {# Rattachées aux clauses plutôt qu'en section propre : le titre et
       l'encadré supplémentaires faisaient déborder le contrat sur une
       deuxième page ne portant que la mention de clôture. #}
    {% if depot.notes|default(false) %}
        <p style="margin-bottom:0;"><strong>Observations :</strong> {{ depot.notes|nl2br }}</p>
    {% endif %}
</div>

<div class="section no-break">
    {{ ui.signatures([
        {
            label: 'Le déposant — lu et approuvé',
            image: companion_signature|default(null),
            fallback: 'À signer',
        },
        {
            label: 'Le dépositaire — ' ~ atelier.nom|default('Atelier Moto'),
            image: null,
            fallback: 'À signer',
        },
    ]) }}
</div>

<div class="legal">
    Contrat établi en deux exemplaires originaux, un pour chacune des parties.
</div>

{% endblock %}
