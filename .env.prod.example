# ============================================================
# Paddock — modèle d'environnement de PRODUCTION
# Copier en `.env` sur le serveur cible et remplir chaque valeur.
# Détail et ordre des opérations : DEPLOIEMENT.md
# ============================================================

# --- Domaine STAFF (back-office : appli atelier, derrière login). HTTPS auto.
# Edge durci dans le Caddyfile (Mercure anonyme / photos brutes / /api/docs bloqués).
APP_DOMAIN=atelier.motoblouz.com

# --- Domaine CLIENT (prise de RDV en ligne + espace client). Surface publique
# à whitelist stricte (Caddyfile). Sous-domaine séparé — NOM À CONFIRMER.
# Laisser vide en dev (retombe sur le port 81 local).
PUBLIC_DOMAIN=rdv.motoblouz.com

# URL publique complète utilisée dans les liens des EMAILS envoyés aux clients
# (confirmation, suivi) → doit pointer le domaine CLIENT ci-dessus.
PUBLIC_URL=https://rdv.motoblouz.com

# --- Symfony
APP_ENV=prod
# Générer : openssl rand -hex 32
APP_SECRET=CHANGEME
# Clés JWT : régénérer sur le serveur (php bin/console lexik:jwt:generate-keypair --overwrite)
# puis reporter la passphrase choisie ici
JWT_SECRET_KEY=CHANGEME
JWT_PASSPHRASE=CHANGEME

# --- Base de données
POSTGRES_USER=atelier
# Générer : openssl rand -hex 24
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=atelier_moto

# --- Compte admin initial (créé au premier démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME
# Email réel de l'admin (sinon 'admin@atelier.local' par défaut — à personnaliser)
ADMIN_EMAIL=CHANGEME

# --- Mercure (temps réel back-office)
# Générer : openssl rand -hex 32
MERCURE_JWT_SECRET=CHANGEME

# --- Emails : SMTP réel (remplace MailHog)
# Exemple OVH : smtp://user:pass@ssl0.ovh.net:465
MAILER_DSN=CHANGEME
# Adresse d'expéditeur des emails : DOIT correspondre au domaine autorisé par le SMTP
# (sinon les emails sont rejetés). Ex. noreply@rdv.motoblouz.com
MAILER_FROM=CHANGEME

# --- SMS (rappels J-1, confirmations, lien de confirmation par téléphone)
# Laisser SMS_PROVIDER vide = SMS désactivé (les e-mails partent quand même).
# SMS_PROVIDER = twilio | ovh
SMS_PROVIDER=
# Twilio : from = numéro expéditeur au format E.164 (ex. +33756000000)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# OVH SMS : identifiants API OVH + nom du service SMS + expéditeur déclaré
OVH_SMS_APP_KEY=
OVH_SMS_APP_SECRET=
OVH_SMS_CONSUMER_KEY=
OVH_SMS_SERVICE_NAME=
OVH_SMS_SENDER=

# --- Durcissement production
# Forcer le flag Secure sur les cookies client si le proxy TLS
# ne transmet pas X-Forwarded-Proto (sinon détection auto)
CLIENT_COOKIE_SECURE=1
# Rate limit booking public : ne PAS poser la variable en prod
# (retombe sur le défaut de 5/min). La ligne reste en commentaire.
# PUBLIC_BOOKING_RATE_LIMIT=5
