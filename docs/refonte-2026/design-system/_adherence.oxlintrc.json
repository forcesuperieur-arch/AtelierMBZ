        "selector": "JSXOpeningElement[name.name='BayProgrammeRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|error)$/]",
        "message": "<BayProgrammeRow> tone must be one of 'neutral' | 'error'."
