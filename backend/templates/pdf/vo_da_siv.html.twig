{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set accent = '#b45309' %}
{% set accent_soft = '#fffbeb' %}
{% set doc_title = "Préparation de déclaration d'achat SIV" %}

{% set seller = purchase.seller|default(null) %}
{% set vehicule = purchase.vehicule|default(null) %}
{% set blockers = blockers|default([]) %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    'Dossier VO n° <strong>' ~ purchase.id|default('—') ~ '</strong>',
    atelier,
    logo_data_uri,
    ['Support interne prérempli', 'Édité le ' ~ 'now'|date('d/m/Y à H:i')],
    custom_header_html|default(null)
) }}

<div class="section no-break">
    <div class="section-title">État du dossier</div>
    {% if blockers|length %}
        <div class="box-warn">
            <p><strong>Points à régulariser avant finalisation légale :</strong></p>
            <ul style="margin:0;padding-left:14px;">
                {% for blocker in blockers %}<li>{{ blocker }}</li>{% endfor %}
            </ul>
        </div>
    {% else %}
        <div class="box-ok">
            <p>Le dossier contient les informations essentielles pour préparer la saisie SIV.</p>
        </div>
    {% endif %}
</div>

<div class="section no-break">
    <div class="section-title">Vendeur</div>
    <table class="lines">
        <tbody>
            <tr><td style="width:34%;"><strong>Nom et prénom</strong></td>
                <td>{{ ((seller.prenom|default('')) ~ ' ' ~ (seller.nom|default('')))|trim|default('À compléter') }}</td></tr>
            <tr><td><strong>Adresse</strong></td><td>{{ seller.adresse|default('À compléter') }}</td></tr>
            <tr><td><strong>Téléphone</strong></td><td>{{ seller.telephone|default('À compléter') }}</td></tr>
            <tr><td><strong>Courriel</strong></td><td>{{ seller.email|default('À compléter') }}</td></tr>
            <tr><td><strong>Pièce d'identité</strong></td>
                <td>
                    {{ purchase.sellerIdType|default('À compléter') }}
                    {%- if purchase.sellerIdNumber|default(false) %} — n° {{ purchase.sellerIdNumber }}{% endif -%}
                    {%- if purchase.sellerIdDate|default(false) %} (délivrée le {{ purchase.sellerIdDate|date('d/m/Y') }}){% endif -%}
                </td></tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Véhicule</div>
    <table class="lines">
        <tbody>
            <tr><td style="width:34%;"><strong>Immatriculation</strong></td><td>{{ vehicule.plaque|default('À compléter') }}</td></tr>
            <tr><td><strong>Numéro VIN</strong></td><td>{{ vehicule.vin|default('À compléter') }}</td></tr>
            <tr><td><strong>Marque et modèle</strong></td>
                <td>{{ ((vehicule.marque|default('')) ~ ' ' ~ (vehicule.modele|default('')))|trim|default('À compléter') }}</td></tr>
            <tr><td><strong>Première mise en circulation</strong></td>
                <td>{{ vehicule.datePremiereMiseEnCirculation|default(false) ? vehicule.datePremiereMiseEnCirculation|date('d/m/Y') : 'À compléter' }}</td></tr>
            {# Le « km » était collé à la valeur : un champ vide affichait
               « À compléter km ». L'unité fait partie du filtre. #}
            <tr><td><strong>Kilométrage</strong></td>
                <td>{{ vehicule.mileage|default(false) ? vehicule.mileage|km : 'À compléter' }}</td></tr>
            <tr><td><strong>Cylindrée</strong></td>
                <td>{{ vehicule.cylindree|default(false) ? vehicule.cylindree ~ ' cm³' : 'À compléter' }}</td></tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Transaction et contrôles</div>
    <table class="lines">
        <tbody>
            <tr><td style="width:34%;"><strong>Date d'achat</strong></td>
                <td>{{ purchase.purchaseDate|default(false) ? purchase.purchaseDate|date('d/m/Y') : 'À compléter' }}</td></tr>
            <tr><td><strong>Prix d'achat</strong></td><td>{{ purchase.purchasePrice|eur('À compléter') }}</td></tr>
            <tr><td><strong>Certificat de non-gage</strong></td>
                <td>{{ purchase.nonGageDate|default(false) ? 'Vérifié le ' ~ purchase.nonGageDate|date('d/m/Y') : 'À compléter' }}</td></tr>
            <tr><td><strong>Contrôle technique</strong></td>
                <td>{{ purchase.controleTechniqueOk|default(false) ? 'Validé dans le dossier' : 'À vérifier selon le véhicule' }}</td></tr>
            <tr><td><strong>Référence de déclaration</strong></td>
                <td>{{ purchase.sivReference|default('À renseigner après saisie SIV') }}</td></tr>
        </tbody>
    </table>
</div>

<div class="legal">
    Support interne de préparation. Il évite la ressaisie mais ne remplace pas la déclaration officielle
    dans le portail SIV Pro ou auprès d'un prestataire habilité.
</div>

{% endblock %}
