{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/client/**",
              "components/core/**",
              "components/data/**",
              "components/icons/**",
              "components/planning/**",
              "components/shell/**",
              "components/states/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Inter))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|statusLabel|icon|vehicle|detail|detailTone|note|column|row|span|key|ref|className|style|children)$/]",
        "message": "<AppointmentBlock> doesn't accept that prop. Declared props: state, statusLabel, icon, vehicle, detail, detailTone, note, column, row, span."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentBlock'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:received|running|ready|confirmed|waiting|open|conflict|unassigned|done)$/]",
        "message": "<AppointmentBlock> state must be one of 'received' | 'running' | 'ready' | 'confirmed' | 'waiting' | 'open' | 'conflict' | 'unassigned' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentBlock'] > JSXAttribute[name.name='detailTone'] > Literal[value!=/^(?:quiet|warning|error)$/]",
        "message": "<AppointmentBlock> detailTone must be one of 'quiet' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BayCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|state|vehicle|customer|note|key|ref|className|style|children)$/]",
        "message": "<BayCard> doesn't accept that prop. Declared props: name, state, vehicle, customer, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='BayCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:occupied|free|down)$/]",
        "message": "<BayCard> state must be one of 'occupied' | 'free' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BayProgrammeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|label|status|state|tone|key|ref|className|style|children)$/]",
        "message": "<BayProgrammeRow> doesn't accept that prop. Declared props: time, label, status, state, tone."
