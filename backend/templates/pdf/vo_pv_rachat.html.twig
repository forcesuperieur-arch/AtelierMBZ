{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set accent = '#1e3a5f' %}
{% set accent_soft = '#eef2f7' %}
{% set doc_title = 'Procès-verbal de rachat' %}

{% set seller = purchase.seller|default(null) %}
{% set vehicule = purchase.vehicule|default(null) %}

{% block extra_css %}
    .amount-box { border: 1px solid {{ accent }}; background: {{ accent_soft }}; padding: 9px 12px; text-align: center; }
    .amount-box .price { font-size: 20px; font-weight: bold; color: {{ accent }}; margin: 2px 0 0; }
{% endblock %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    'N° <strong>PVR-' ~ purchase.id|default('—') ~ '</strong>',
    atelier,
    logo_data_uri,
    ['Établi le ' ~ (purchase.purchaseDate|default(false) ? purchase.purchaseDate|date('d/m/Y') : 'now'|date('d/m/Y'))],
    custom_header_html|default(null)
) }}

{{ ui.columns([
    ui.field('Vendeur',
        '<strong>' ~ ((seller.prenom|default('')) ~ ' ' ~ (seller.nom|default('')))|trim ~ '</strong>'
        ~ (seller.adresse|default(false) ? '<br>' ~ seller.adresse : '')
        ~ (seller.telephone|default(false) ? '<br>' ~ seller.telephone : '')
        ~ (seller.email|default(false) ? '<br>' ~ seller.email : '')
        ~ '<br><br><span class="field-label">Pièce d\'identité</span>'
        ~ (purchase.sellerIdType|default('—'))
        ~ (purchase.sellerIdNumber|default(false) ? ' n° ' ~ purchase.sellerIdNumber : '')
        ~ (purchase.sellerIdDate|default(false) ? ' du ' ~ purchase.sellerIdDate|date('d/m/Y') : '')),
    ui.field('Acquéreur',
        '<strong>' ~ atelier.nom|default('Atelier Moto') ~ '</strong>'
        ~ (atelier.adresse|default(false) ? '<br>' ~ atelier.adresse : '')
        ~ (atelier.cp|default(false) or atelier.ville|default(false) ? '<br>' ~ atelier.cp ~ ' ' ~ atelier.ville : '')
        ~ (atelier.siret|default(false) ? '<br>SIRET ' ~ atelier.siret : '')
        ~ (purchase.expert|default(false)
            ? '<br><br><span class="field-label">Expert</span>' ~ ((purchase.expert.prenom|default('')) ~ ' ' ~ (purchase.expert.nom|default('')))|trim
            : '')),
]) }}

<div class="section no-break">
    <div class="section-title">Véhicule objet de la transaction</div>
    <table class="lines">
        <tbody>
            <tr>
                <td style="width:25%;"><strong>Marque et modèle</strong></td>
                <td style="width:25%;">{{ ((vehicule.marque|default('')) ~ ' ' ~ (vehicule.modele|default('')))|trim|default('—') }}</td>
                <td style="width:25%;"><strong>Immatriculation</strong></td>
                <td>{{ vehicule.plaque|default('—') }}</td>
            </tr>
            <tr>
                <td><strong>Numéro VIN</strong></td>
                <td>{{ vehicule.vin|default('—') }}</td>
                <td><strong>Cylindrée</strong></td>
                <td>{{ vehicule.cylindree|default(false) ? vehicule.cylindree ~ ' cm³' : '—' }}</td>
            </tr>
            <tr>
                <td><strong>Année</strong></td>
                <td>{{ vehicule.annee|default('—') }}</td>
                <td><strong>Kilométrage compteur</strong></td>
                <td>{{ vehicule.mileage|default(false) ? vehicule.mileage|km : '—' }}</td>
            </tr>
            <tr>
                <td><strong>Couleur</strong></td>
                <td colspan="3">{{ vehicule.couleur|default('—') }}</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="amount-box">
        <span class="field-label">Prix de rachat convenu</span>
        <p class="price">{{ purchase.purchasePrice|eur }}</p>
    </div>
</div>

{# Vérifications et observations sont courtes : côte à côte, elles laissent la
   place au bloc signatures sur la même page. #}
{% set aVerifications = purchase.nonGageDate|default(false) or purchase.controleTechniqueOk|default(false) %}
{% if aVerifications or purchase.notes|default(false) %}
    <table class="cols no-break">
        <tr>
            {% if aVerifications %}
                <td>
                    <div class="section-title">Vérifications effectuées</div>
                    <div class="box-ok">
                        {% if purchase.nonGageDate|default(false) %}
                            <p>Certificat de situation administrative (non-gage) vérifié le {{ purchase.nonGageDate|date('d/m/Y') }}.</p>
                        {% endif %}
                        {% if purchase.controleTechniqueOk|default(false) %}
                            <p style="margin-bottom:0;">Contrôle technique en cours de validité.</p>
                        {% endif %}
                    </div>
                </td>
            {% endif %}
            {% if purchase.notes|default(false) %}
                <td>
                    <div class="section-title">Observations</div>
                    <div class="box"><p style="margin-bottom:0;">{{ purchase.notes|nl2br }}</p></div>
                </td>
            {% endif %}
        </tr>
    </table>
{% endif %}

<div class="section no-break">
    <div class="section-title">Déclarations du vendeur</div>
    <p>Le vendeur déclare, sous sa responsabilité :</p>
    <ul style="margin:0 0 6px;padding-left:16px;">
        <li>être le propriétaire légitime du véhicule décrit ci-dessus ;</li>
        <li>que le véhicule ne fait l'objet d'aucun gage, opposition ni saisie ;</li>
        <li>que le kilométrage porté au compteur est exact à sa connaissance ;</li>
        <li>remettre l'ensemble des documents afférents au véhicule (carte grise barrée, certificat de cession, certificat de situation administrative).</li>
    </ul>
</div>

<div class="section no-break">
    {{ ui.signatures([
        {
            label: 'Le vendeur — lu et approuvé',
            image: companion_signature|default(null),
            fallback: 'À signer',
        },
        {
            label: "L'acquéreur — " ~ atelier.nom|default('Atelier Moto'),
            image: null,
            fallback: 'À signer',
        },
    ]) }}
</div>

<div class="legal">
    Procès-verbal établi en deux exemplaires originaux, un pour chacune des parties.
</div>

{% endblock %}
