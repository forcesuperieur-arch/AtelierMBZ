{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{#
  Ordre de réparation : document unique en trois volets (réception,
  intervention, restitution) imprimé dès la prise en charge. Les volets 2 et 3
  sont donc vides au moment de l'impression : ils sont mis en page comme des
  feuilles de travail à compléter à la main plutôt que laissés blancs.
#}

{% set doc_title = 'Ordre de réparation' %}
{% set reference = 'N° <strong>' ~ or.numeroOr ~ '</strong>' %}

{% set vMarque = or.snapVehiculeMarque ?? (rdv.vehicule ? rdv.vehicule.marque : null) %}
{% set vModele = or.snapVehiculeModele ?? (rdv.vehicule ? rdv.vehicule.modele : null) %}
{% set vPlaque = or.snapVehiculePlaque ?? (rdv.vehicule ? rdv.vehicule.plaque : null) %}
{% set clientPrenom = or.snapClientPrenom ?? (rdv.client ? rdv.client.prenom : null) %}
{% set clientNom = or.snapClientNom ?? (rdv.client ? rdv.client.nom : null) %}
{% set clientNomComplet = (clientPrenom ~ ' ' ~ clientNom)|trim %}
{% set vehiculeLibelle = (vMarque ~ ' ' ~ vModele)|trim %}

{% set prestations = rdv.prestationsSnapshot|default([]) %}
{% set montantEstime = or.montantEstime ?? rdv.prixEstime|default(null) %}

{% block body %}

{# ================= VOLET 1 — RÉCEPTION ================= #}
{% set headerMeta = [] %}
{% if or.statut|default(false) %}
    {% set headerMeta = headerMeta|merge(['Statut : <span class="badge">' ~ or.statut|replace({'_': ' '})|upper ~ '</span>']) %}
{% endif %}
{% if or.typeOr|default(false) and or.typeOr != 'initial' %}
    {% set headerMeta = headerMeta|merge(['Type : ' ~ or.typeOr|replace({'_': ' '})|capitalize]) %}
{% endif %}
{% if or.createdAt|default(false) %}
    {% set headerMeta = headerMeta|merge(['Établi le ' ~ or.createdAt|date('d/m/Y à H:i')]) %}
{% endif %}

{{ ui.header(doc_title|upper, reference, atelier, logo_data_uri, headerMeta, custom_header_html|default(null)) }}

{{ ui.columns([
    ui.field('Client', clientNomComplet ? (
        '<strong>' ~ clientNomComplet ~ '</strong>'
        ~ (rdv.client and rdv.client.telephone ? '<br>' ~ rdv.client.telephone : '')
        ~ (rdv.client and rdv.client.email ? '<br>' ~ rdv.client.email : '')
    ) : null),
    ui.field('Véhicule', vehiculeLibelle ? (
        '<strong>' ~ vehiculeLibelle ~ '</strong>'
        ~ (vPlaque ? '<br>Plaque ' ~ vPlaque : '')
        ~ (or.kilometrage ? '<br>Km à la réception : ' ~ or.kilometrage|km : '')
    ) : null),
]) }}

{{ ui.columns([
    ui.field('Rendez-vous', rdv.dateRdv|default(false)
        ? rdv.dateRdv|date('d/m/Y') ~ (rdv.heureRdv|default(false) ? ' à ' ~ rdv.heureRdv|date('H:i') : '')
        : null),
    ui.field('Pont', rdv.pont|default(false) ? rdv.pont.nom : null, 'Non assigné'),
    ui.field('Mécanicien', rdv.mecanicien|default(false)
        ? (rdv.mecanicien.prenom ~ ' ' ~ rdv.mecanicien.nom)|trim
        : null, 'Non assigné'),
    ui.field('Intervention', rdv.typeIntervention|default(null)),
]) }}

{% if rdv.commentaire|default(false) or or.travaux|default(false) or or.etatVehicule|default(false) %}
    <div class="section">
        {% if or.travaux|default(false) %}
            <div class="section-title">Travaux à effectuer</div>
            <p>{{ or.travaux|nl2br }}</p>
        {% endif %}
        {{ ui.columns([
            rdv.commentaire|default(false) ? ui.field('Commentaire à la réception', rdv.commentaire|nl2br) : null,
            or.etatVehicule|default(false) ? ui.field('État constaté du véhicule', or.etatVehicule|nl2br) : null,
        ]) }}
    </div>
{% endif %}

{#
  Prestations réservées : le client signe un montant estimé, il doit pouvoir en
  lire le détail. Le snapshot est posé sur le RDV à la réservation.
#}
{% if prestations|length %}
    <div class="section no-break">
        <div class="section-title">Prestations réservées</div>
        <table class="lines">
            <thead>
                <tr>
                    <th>Désignation</th>
                    <th class="right nowrap">Durée</th>
                    <th class="right nowrap">Prix indicatif</th>
                </tr>
            </thead>
            <tbody>
                {% for prestation in prestations %}
                    {% set prixLigne = prestation.prix_ttc|default(0) > 0 ? prestation.prix_ttc : prestation.prix_ht|default(null) %}
                    <tr>
                        <td>{{ prestation.designation|default('Prestation') }}</td>
                        <td class="right nowrap">{{ prestation.duree|default(0) > 0 ? prestation.duree|duree : '—' }}</td>
                        <td class="right nowrap">{{ prixLigne ? prixLigne|eur : '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

{% if montantEstime or rdv.tempsEstime|default(false) %}
    {{ ui.totals([
        rdv.tempsEstime|default(false) ? { label: 'Durée estimée', value: rdv.tempsEstime|duree } : null,
        montantEstime ? { label: 'Total estimé (indicatif)', value: montantEstime|eur, variant: 'grand' } : null,
    ]) }}
    <p class="tiny">Montant indicatif établi à la réception. Tout travail supplémentaire fera l'objet d'un accord préalable du client.</p>
{% endif %}

{% if reception_photos|default([])|length %}
    <div class="section no-break">
        <div class="section-title">Photos de réception</div>
        {{ ui.photos(reception_photos, 'Photo réception') }}
    </div>
{% endif %}

<div class="section no-break">
    {{ ui.signatures([
        {
            label: 'Signature du client — réception',
            image: or.signatureClient|default(null),
            caption: or.signedAt|default(false) ? 'Signé le ' ~ or.signedAt|date('d/m/Y à H:i') : null,
        },
        {
            label: "Signature de l'atelier — réception",
            image: or.signatureAtelierReception|default(null),
            caption: or.signeReceptionnisteAt|default(false) ? 'Signé le ' ~ or.signeReceptionnisteAt|date('d/m/Y à H:i') : null,
        },
    ]) }}
    <p class="tiny">Le client reconnaît avoir pris connaissance des travaux à effectuer et donne son accord pour leur exécution.</p>
</div>

{# ================= VOLET 2 — INTERVENTION ================= #}
<div class="break-before"></div>
{{ ui.header_continued("FEUILLE D'INTERVENTION", reference, atelier, logo_data_uri) }}

{{ ui.columns([
    ui.field('Client', clientNomComplet),
    ui.field('Véhicule', vehiculeLibelle ~ (vPlaque ? ' — ' ~ vPlaque : '')),
    ui.field('Mécanicien', rdv.mecanicien|default(false)
        ? (rdv.mecanicien.prenom ~ ' ' ~ rdv.mecanicien.nom)|trim
        : null, 'À compléter'),
]) }}

{% if or.mechanicNotes|default(false) %}
    <div class="section">
        <div class="section-title">Notes du mécanicien</div>
        <div class="box-accent"><p>{{ or.mechanicNotes|nl2br }}</p></div>
        {% if or.mechanicNotesUpdatedAt|default(false) %}
            <p class="tiny">Mise à jour le {{ or.mechanicNotesUpdatedAt|date('d/m/Y à H:i') }}</p>
        {% endif %}
    </div>
{% endif %}

{% if or.mechanicCheckup|default([])|length %}
    <div class="section no-break">
        <div class="section-title">Checkup de réception</div>
        <table class="lines">
            <tbody>
                {% for key, item in or.mechanicCheckup %}
                    <tr>
                        <td style="width:45%;"><strong>{{ item.label|default(key)|replace({'_': ' '})|capitalize }}</strong></td>
                        <td>
                            {%- if item is iterable -%}
                                {{ item.value|default('—') }}
                                {%- if item.note|default(false) %} <span class="sub">({{ item.note }})</span>{% endif -%}
                            {%- else -%}
                                {{ item }}
                            {%- endif -%}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if or.mechanicCheckupUpdatedAt|default(false) %}
            <p class="tiny">Mise à jour le {{ or.mechanicCheckupUpdatedAt|date('d/m/Y à H:i') }}</p>
        {% endif %}
    </div>
{% endif %}

<div class="section">
    <div class="section-title">Travaux réalisés</div>
    {% if or.travauxRealises|default(false) %}
        <p>{{ or.travauxRealises|nl2br }}</p>
    {% else %}
        {# Volet imprimé avant l'intervention : on fournit de quoi écrire. #}
        {{ ui.ruled_lines(6) }}
    {% endif %}
</div>

{% if or.alertes|default(false) %}
    <div class="section no-break">
        <div class="section-title">Points de vigilance</div>
        <div class="box-alert">
            {% if or.alertes is iterable %}
                <ul style="margin:0;padding-left:14px;">
                    {% for alerte in or.alertes %}<li>{{ alerte }}</li>{% endfor %}
                </ul>
            {% else %}
                <p>{{ or.alertes|nl2br }}</p>
            {% endif %}
        </div>
    </div>
{% endif %}

{# Recommandations et garantie sont courtes : côte à côte, elles laissent la
   place au bloc signatures sur la même page. #}
{% if or.recommandations|default(false) or or.garantie|default(false) %}
    <table class="cols no-break">
        <tr>
            {% if or.recommandations|default(false) %}
                <td>
                    <div class="section-title">Recommandations</div>
                    <div class="box-warn"><p>{{ or.recommandations|nl2br }}</p></div>
                </td>
            {% endif %}
            {% if or.garantie|default(false) %}
                <td>
                    <div class="section-title">Garantie</div>
                    <div class="box-ok"><p>{{ or.garantie|nl2br }}</p></div>
                </td>
            {% endif %}
        </tr>
    </table>
{% endif %}

{% if intervention_photos|default([])|length %}
    <div class="section no-break">
        <div class="section-title">Photos d'intervention</div>
        {{ ui.photos(intervention_photos, 'Photo intervention') }}
    </div>
{% endif %}

<div class="section no-break">
    {{ ui.signatures([
        {
            label: 'Signature du mécanicien',
            image: or.signatureMecanicien|default(null),
            caption: or.signeMecanicienAt|default(false) ? 'Signé le ' ~ or.signeMecanicienAt|date('d/m/Y à H:i') : null,
        },
        {
            label: "Kilométrage en fin d'intervention",
            image: null,
            fallback: or.kilometrageRestitution|default(false) ? or.kilometrageRestitution|km : '____________ km',
        },
    ]) }}
</div>

{# ================= VOLET 3 — RESTITUTION ================= #}
<div class="break-before"></div>
{{ ui.header_continued('RESTITUTION DU VÉHICULE', reference, atelier, logo_data_uri) }}

{{ ui.columns([
    ui.field('Client', clientNomComplet),
    ui.field('Véhicule', vehiculeLibelle ~ (vPlaque ? ' — ' ~ vPlaque : '')),
    ui.field('Kilométrage constaté', or.kilometrageRestitution|default(false) ? or.kilometrageRestitution|km : null, 'À compléter'),
]) }}

<div class="section">
    <p>Je soussigné(e) <strong>{{ clientNomComplet|default('……………………………………') }}</strong> déclare avoir récupéré mon véhicule
       {% if vehiculeLibelle %}<strong>{{ vehiculeLibelle }}{% if vPlaque %} ({{ vPlaque }}){% endif %}</strong>{% endif %},
       avoir pris connaissance des travaux effectués et des recommandations formulées par l'atelier.</p>
</div>

<div class="section no-break">
    <div class="section-title">Périodicité d'entretien des fluides</div>
    <table class="lines">
        <tbody>
            <tr><td>Huile moteur</td><td class="right"><strong>tous les ans</strong></td></tr>
            <tr><td>Liquide de frein</td><td class="right"><strong>tous les 2 ans</strong></td></tr>
            <tr><td>Liquide de refroidissement</td><td class="right"><strong>tous les 3 ans</strong></td></tr>
        </tbody>
    </table>
    <p class="tiny">Périodicités indicatives — se référer au carnet d'entretien du constructeur.</p>
</div>

{% if restitution_photos|default([])|length %}
    <div class="section no-break">
        <div class="section-title">Photos de restitution</div>
        {{ ui.photos(restitution_photos, 'Photo restitution') }}
    </div>
{% endif %}

<div class="section no-break">
    {{ ui.signatures([
        {
            label: 'Signature du client — restitution',
            image: or.signatureClientRestitution|default(null),
            caption: or.signeClientRestitutionAt|default(false) ? 'Signé le ' ~ or.signeClientRestitutionAt|date('d/m/Y à H:i') : null,
        },
        {
            label: 'Date de restitution',
            image: null,
            fallback: or.signeClientRestitutionAt|default(false) ? or.signeClientRestitutionAt|date('d/m/Y') : '……… / ……… / …………',
        },
    ]) }}
</div>

{% if or.signedHash|default(false) %}
    <div class="legal">
        Empreinte d'intégrité : {{ or.signedHash }}
        {%- if or.signedAt|default(false) %} — horodatage {{ or.signedAt|date('d/m/Y H:i:s') }}{% endif %}
    </div>
{% endif %}

{% endblock %}
