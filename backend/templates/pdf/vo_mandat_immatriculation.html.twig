{% extends 'pdf/_layout.html.twig' %}
{% import 'pdf/_macros.html.twig' as ui %}

{% set doc_title = "Préparation de mandat d'immatriculation" %}

{% block body %}

{{ ui.header(
    doc_title|upper,
    record.reference|default(false) ? 'Dossier <strong>' ~ record.reference ~ '</strong>' : null,
    atelier,
    logo_data_uri,
    ['Support prérempli pour la vente VO', 'Édité le ' ~ 'now'|date('d/m/Y à H:i')],
    custom_header_html|default(null)
) }}

<div class="section no-break">
    <div class="section-title">Mandant — futur titulaire</div>
    <table class="lines">
        <tbody>
            <tr><td style="width:34%;"><strong>Nom et prénom</strong></td>
                <td>{{ buyer|default(false) ? ((buyer.prenom|default('')) ~ ' ' ~ (buyer.nom|default('')))|trim : 'À compléter lors de la vente' }}</td></tr>
            <tr><td><strong>Adresse</strong></td>
                <td>{{ buyer.adresse|default(false)
                        ? buyer.adresse ~ (buyer.cp|default(false) or buyer.ville|default(false) ? ', ' ~ buyer.cp ~ ' ' ~ buyer.ville : '')
                        : 'À compléter' }}</td></tr>
            <tr><td><strong>Téléphone</strong></td><td>{{ buyer.telephone|default('À compléter') }}</td></tr>
            <tr><td><strong>Courriel</strong></td><td>{{ buyer.email|default('À compléter') }}</td></tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    <div class="section-title">Véhicule concerné</div>
    <table class="lines">
        <tbody>
            <tr><td style="width:34%;"><strong>Immatriculation</strong></td><td>{{ vehicle.plaque|default('À compléter') }}</td></tr>
            <tr><td><strong>Numéro VIN</strong></td><td>{{ vehicle.vin|default('À compléter') }}</td></tr>
            <tr><td><strong>Marque et modèle</strong></td>
                <td>{{ ((vehicle.marque|default('')) ~ ' ' ~ (vehicle.modele|default('')))|trim|default('À compléter') }}</td></tr>
            <tr><td><strong>Première mise en circulation</strong></td>
                <td>{{ vehicle.datePremiereMiseEnCirculation|default(false) ? vehicle.datePremiereMiseEnCirculation|date('d/m/Y') : 'À compléter' }}</td></tr>
            <tr><td><strong>Kilométrage</strong></td>
                <td>{{ vehicle.mileage|default(false) ? vehicle.mileage|km : 'À compléter' }}</td></tr>
        </tbody>
    </table>
</div>

{% if seller|default(false) %}
    <div class="section no-break">
        <div class="section-title">Ancien titulaire</div>
        <table class="lines">
            <tbody>
                <tr><td style="width:34%;"><strong>Nom et prénom</strong></td>
                    <td>{{ ((seller.prenom|default('')) ~ ' ' ~ (seller.nom|default('')))|trim|default('À compléter') }}</td></tr>
                <tr><td><strong>Adresse</strong></td><td>{{ seller.adresse|default('À compléter') }}</td></tr>
            </tbody>
        </table>
    </div>
{% endif %}

<div class="section no-break">
    <div class="section-title">Professionnel mandaté</div>
    <table class="lines">
        <tbody>
            <tr><td style="width:34%;"><strong>Raison sociale</strong></td><td>{{ atelier.nom|default('À compléter') }}</td></tr>
            <tr><td><strong>Adresse</strong></td>
                <td>{{ atelier.adresse|default(false)
                        ? atelier.adresse ~ (atelier.cp|default(false) or atelier.ville|default(false) ? ', ' ~ atelier.cp ~ ' ' ~ atelier.ville : '')
                        : 'À compléter' }}</td></tr>
            <tr><td><strong>SIRET</strong></td><td>{{ atelier.siret|default('À compléter') }}</td></tr>
            <tr><td><strong>Contact</strong></td><td>{{ atelier.telephone|default('À compléter') }}</td></tr>
        </tbody>
    </table>
</div>

<div class="section no-break">
    {{ ui.signatures([
        { label: 'Signature du mandant', image: null, fallback: 'À signer' },
        { label: 'Cachet et signature du professionnel', image: null, fallback: 'À signer' },
    ]) }}
</div>

<div class="legal">
    Support interne de préparation. À faire signer selon le circuit SIV réellement utilisé par l'atelier ;
    il ne se substitue pas au formulaire officiel de mandat (Cerfa n° 13757).
</div>

{% endblock %}
